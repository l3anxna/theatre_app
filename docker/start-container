#!/bin/sh
set -eu

: "${PORT:=8080}"
export PORT

# These paths are used by Laravel for cached configuration, sessions, and
# compiled Blade templates. They may be absent when a deployment is restored
# from a filesystem without empty Git directories, so create them before
# Artisan or PHP-FPM boot the application.
mkdir -p \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache
chown -R www-data:www-data storage bootstrap/cache

# Render starts a web service before it has an .env file. Provide a working,
# self-contained SQLite fallback unless the service was configured with a
# database connection. A configured database is never replaced.
if [ -z "${DB_CONNECTION:-}" ]; then
    if [ -n "${DB_HOST:-}" ]; then
        export DB_CONNECTION=mysql
    else
        export DB_CONNECTION=sqlite
        : "${DB_DATABASE:=/var/www/database/database.sqlite}"
        export DB_DATABASE
    fi
fi

# Laravel cannot serve requests without an encryption key. Prefer a stable
# APP_KEY configured in Render; this fallback prevents a blank deployment from
# responding with HTTP 500 while making the missing configuration visible.
if [ -z "${APP_KEY:-}" ]; then
    export APP_KEY="base64:$(php -r 'echo base64_encode(random_bytes(32));')"
    echo "APP_KEY is not set; using a temporary key for this container." >&2
fi

php artisan migrate --force --no-interaction

envsubst '${PORT}' \
    < /etc/nginx/templates/default.conf.template \
    > /etc/nginx/conf.d/default.conf

exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
